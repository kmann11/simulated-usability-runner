# Where the FastAPI backend lives. Used by Vite as the dev-server proxy
# target for /api/*. Defaults to http://localhost:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: override the API base URL the browser uses directly.
# Leave empty to use the Vite dev proxy at /api (recommended for local dev).
# Example for hitting the backend directly: VITE_API_BASE=http://localhost:8000
#
# For the GitHub Pages UI (https://kmann11.github.io/simulated-usability-runner/),
# set this to a publicly reachable HTTPS FastAPI URL (Render, Railway, etc.).
# GitHub Pages cannot run the Python backend. You can also set the same value
# as a GitHub Actions repository variable named VITE_API_BASE so the Pages
# build bakes it in.
VITE_API_BASE=

# Optional: Vite asset base path. Defaults to "/".
# GitHub Pages builds set GITHUB_PAGES=true which uses "/simulated-usability-runner/".
# VITE_BASE=/simulated-usability-runner/

# Optional: override the dev-server port. Defaults to 5273 so this app
# does not collide with other Vite projects (which typically use 5173).
# Set this if 5273 is also taken on your machine.
# VITE_PORT=5374
